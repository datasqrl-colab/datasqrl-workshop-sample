{
  "version": "1",
  "enabled-engines": ["kafka","flink", "postgres", "vertx"],
  "script": {
    "main": "seller-analytics.sqrl",
    "config": {
      "environment": "prod"
    }
  },
  "engines": {
    "flink": {
      "config": {
        "execution.runtime-mode": "STREAMING",
        "table.exec.source.idle-timeout": "30 s"
      }
    }
  },
  "compiler": {
    "predicate-pushdown-rules": "LIMITED_RULES"
  }
}
